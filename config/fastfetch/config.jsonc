{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/nixowos-small.txt",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    },
    "color": {
      "1": "38;2;82;119;195",
      "2": "38;2;126;186;228",
      "3": "38;2;223;144;175",
      "4": "38;2;45;120;158"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 15
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#34}╭─── {#1;36}{user-name}{#34}@{#1;35}{host-name}{#34} ─────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "{#34}│ {#36}  os",
      "format": "{pretty-name<35} {#34}│"
    },
    {
      "type": "kernel",
      "key": "{#34}│ {#36}  kernel",
      "format": "{release<35} {#34}│"
    },
    {
      "type": "uptime",
      "key": "{#34}│ {#36}  uptime",
      "format": "{formatted<35} {#34}│"
    },
    {
      "type": "wm",
      "key": "{#34}│ {#36}  wm",
      "format": "{pretty-name<35} {#34}│"
    },
    {
      "type": "shell",
      "key": "{#34}│ {#36}  shell",
      "format": "{pretty-name} {version<29} {#34}│"
    },
    {
      "type": "packages",
      "key": "{#34}│ {#36}  pkgs",
      "format": "{all<35} {#34}│"
    },
    {
      "type": "memory",
      "key": "{#34}│ {#36}  memory",
      "format": "{used} / {total<24} {#34}│"
    },
    {
      "type": "battery",
      "key": "{#34}│ {#36}󰁹  battery",
      "format": "{capacity<4} ({status<28}) {#34}│"
    },
    {
      "type": "custom",
      "format": "{#34}╰────────────────────────────────────────────────────╯"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
